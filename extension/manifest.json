{
  "manifest_version": 3,
  "name": "ReadLoop",
  "short_name": "ReadLoop",
  "description": "Practice translation from real web reading and save weak points to your own Feishu Bitable.",
  "version": "0.3.0",
  "homepage_url": "https://readinsight.bamamei.online",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open ReadLoop",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://readinsight.bamamei.online/*",
    "https://open.feishu.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
