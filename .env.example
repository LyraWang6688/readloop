# ReadLoop 后端服务环境变量
# 数据存在用户自己的飞书多维表格，这里不需要 DATABASE_URL。
# 实现说明见 docs/API_IMPLEMENTATION.md

# 服务端口
PORT=3000

# 服务端兜底模型（请求体里带用户自己的 model 配置时优先用请求里的）
# 见 docs/ARCHITECTURE.md §5.5 用户自带模型（BYOK）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# 授权密钥（部署时务必替换成随机长串）
# LICENSE_SECRET：既用于授权码校验位，也用于签发/校验 host_token
# QUESTION_ID_SECRET：用于给 question_id 签名（内含答案，客户端不可伪造）
# 轮换 LICENSE_SECRET = 所有旧授权码失效
LICENSE_SECRET=change-me
QUESTION_ID_SECRET=change-me

# 发起方应用：仅作为 registerApp 的 source 标识与留档。
# 一键创建走飞书公开的 Device Grant 注册端点，不需要本应用凭证；缺失不阻塞。
# 见 docs/ARCHITECTURE.md §4.3
FEISHU_INITIATOR_APP_ID=cli_aa51d940d7381c06
FEISHU_INITIATOR_APP_SECRET=

# 出题题面默认走确定性模板（见 docs/DECISIONS.md「MVP 题面用确定性模板」）。
# 置为 1 才启用大模型润色：失败会自动回退模板，不影响判分与选题。
# READLOOP_QUESTION_LLM=0
